# =============================================================
# PasalBerapa? — Environment Configuration Example
# =============================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pasalberapa
POSTGRES_PORT=5432

# Backend Hub
BACKEND_PORT=8000
JWT_SECRET=pasalberapa-dev-secret-change-me

# AI Node LLM Configuration
AI_NODE_PORT=8001
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
TOP_K_DEFAULT=6

# pasal.id — live Indonesian legal search (free account: https://pasal.id/akun)
# One or more tokens, comma-separated — requests rotate round-robin across
# them to spread the per-token rate limit (60 req/min each).
PASAL_API_TOKENS=your_pasal_id_token_here
# Optional: point at a reverse proxy instead of pasal.id directly (e.g. a
# Cloudflare Worker) if this node's own network path to pasal.id is
# broken/blocked. HTTP_PROXY_KEY is the shared secret the proxy expects,
# sent as X-Proxy-Key — leave both unset to call pasal.id directly.
# PASAL_API_BASE=https://your-proxy.workers.dev/pasal.id/api/v1
# HTTP_PROXY_KEY=your_proxy_shared_secret
# PASAL_TIMEOUT=15

# CORS
CORS_ORIGINS=*
